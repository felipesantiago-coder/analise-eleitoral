// Schema do Voto Claro.
//
// Pesquisa eleitoral anônima com um voto por pessoa em cada cargo:
// - ChaveEleitor guarda apenas um código derivado (HMAC-SHA256 com sal
//   secreto do servidor sobre IP + user-agent + impressão do navegador +
//   cargo). É um identificador unidirecional: não permite reconstruir o IP
//   nem identificar a pessoa; serve somente para recusar segundo voto.
// - VotoPesquisa guarda o voto em si (cargo + candidato), SEM qualquer
//   vínculo, chave estrangeira ou carimbo que o ligue a ChaveEleitor. As duas
//   tabelas não têm coluna em comum: mesmo com acesso total ao banco, não é
//   possível dizer em quem alguém votou.
// - Configuracao guarda o sal secreto da pesquisa, gerado uma única vez.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ChaveEleitor {
  chave String @id
}

model VotoPesquisa {
  id            String   @id @default(cuid())
  cargo         String
  candidatoSlug String
  criadoEm      DateTime @default(now())

  @@index([cargo, candidatoSlug])
}

model Configuracao {
  chave String @id
  valor String
}
